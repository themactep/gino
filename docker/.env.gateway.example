# ═══════════════════════════════════════════════════════
# Gino Gateway — Multi-Tenant Assistant Configuration
# ═══════════════════════════════════════════════════════
# Copy to .env and fill in your values.

# ═══ LLM Provider ════════════════════════════════════

# REQUIRED — API key for your LLM provider
OPENAI_API_KEY=

# OpenAI-compatible API base URL
# Examples:
#   z.ai coding:  https://api.z.ai/api/coding/paas/v4
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Groq:         https://api.groq.com/openai/v1
OPENAI_API_BASE=https://api.z.ai/api/coding/paas/v4

# Model identifier (provider-specific)
GINO_MODEL=glm-4-flash

# Max response tokens per message (default: 8192)
GINO_MAX_TOKENS=8192

# Max tool call iterations per message (default: 30)
# Individual tiers can override this
GINO_MAX_TOOL_ITERATIONS=30

# ═══ External Ollama (REQUIRED for brain embeddings) ═══

# URL of your external Ollama instance
# If Ollama runs in another container on the same host:
#   http://<ollama-container-name>:11434
# If Ollama runs on the host:
#   http://host.docker.internal:11434  (Docker Desktop)
#   http://172.17.0.1:11434            (Linux Docker)
OLLAMA_URL=http://ollama:11434

# Embedding model (auto-pulled by Ollama)
GINO_BRAIN_EMBEDDING_MODEL=nomic-embed-text

# ═══ API Gateway ═════════════════════════════════════

# Port to expose the API + Admin UI on the host
GINO_API_PORT=8080

# Internal listen address (usually leave as :8080)
GINO_API_ADDR=:8080

# Secret used to sign admin session cookies
# Generate with: openssl rand -hex 32
GINO_API_ADMIN_SECRET=

# ═══ Audit Trail ═════════════════════════════════════

# Message retention in days (default: 7)
GINO_AUDIT_MESSAGE_RETENTION=7

# Token usage / cost retention in days (default: 365)
GINO_AUDIT_USAGE_RETENTION=365

# ═══ Tenant System ═══════════════════════════════════

# Root directory for per-user workspaces (inside container)
GINO_TENANT_WORKSPACE_ROOT=/home/gino/.gino/data/workspaces

# Idle user eviction timeout (users not seen for this long get evicted from cache)
GINO_TENANT_EVCTION_TIMEOUT=30m

# ═══ Optional: Telegram Channel ══════════════════════

# The gateway can also serve as a Telegram bot simultaneously.
# Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_FROM=

# ═══ Optional: Discord Channel ═══════════════════════

DISCORD_BOT_TOKEN=
DISCORD_ALLOW_FROM=

# ═══ Optional: Brave Search ══════════════════════════

# If set, enables Brave Search as the web_search provider
# Get a free key at https://brave.com/search/api/
GINO_BRAVE_SEARCH_API_KEY=

# ═══ Docker Settings ═════════════════════════════════

# Absolute host path to persist all gateway data
# Contains: config.json, tenant.db, audit.db, per-user workspaces
GINO_DATA_PATH=/opt/gino/gateway-data
