# syntax=docker/dockerfile:1.7
#
# Dockerfile.gateway — Multi-tenant assistant gateway
# No bundled Ollama (use external instance via OLLAMA_URL).
# API + Admin UI on port 8080 by default.
#

# ---- Stage 1: Build Gino binary ----
FROM golang:1.26-alpine AS gino-builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /gino ./cmd/gino

# ---- Stage 2: Final runtime image ----
FROM debian:13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl tzdata bash jq gosu && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r gino && useradd -r -g gino -m gino

# Copy Gino binary
COPY --from=gino-builder /gino /usr/local/bin/gino
RUN chmod +x /usr/local/bin/gino

# Gino home directory
ENV GINO_HOME=/home/gino/.gino
ENV GINO_BRAIN_ENABLED=true

# Gateway-specific defaults
ENV GINO_API_ENABLED=true
ENV GINO_API_ADDR=:8080

RUN mkdir -p ${GINO_HOME}/workspace/memory \
             ${GINO_HOME}/workspace/skills \
             ${GINO_HOME}/data/workspaces && \
    chown -R gino:gino /home/gino

COPY docker/entrypoint.gateway.sh /entrypoint.sh
COPY docker/init.sh /init.sh
RUN chmod +x /entrypoint.sh /init.sh

# API + Admin UI
EXPOSE 8080

WORKDIR /home/gino/.gino

ENTRYPOINT ["/init.sh"]
CMD ["gateway"]
